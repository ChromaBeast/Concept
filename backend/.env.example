# Appwrite Backend Functions Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=concept-app
APPWRITE_API_KEY=your_appwrite_server_api_key
APPWRITE_DATABASE_ID=concepts_db

# Google Gemini API Key & Cost-Effective Model Selection
GEMINI_API_KEY=your_gemini_api_key
# High-quality primary generation model (e.g. gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash)
GEMINI_MODEL=gemini-3.8-flash
# High-speed validation model (e.g. gemini-3.8-flash, gemini-3.1-flash-lite)
GEMINI_VALIDATOR_MODEL=gemini-3.8-flash

# Pipeline Tuning
BATCH_SIZE=15
CONCURRENCY=3
