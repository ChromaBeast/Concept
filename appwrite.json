{
  "projectId": "concept-app",
  "projectName": "Concept",
  "functions": [
    {
      "$id": "runContentPipeline",
      "name": "Run Content Pipeline",
      "runtime": "go-1.23",
      "path": "backend/functions/runContentPipeline",
      "entrypoint": "main.go",
      "schedule": "0 2 * * *",
      "timeout": 300,
      "enabled": true,
      "logging": true
    },
    {
      "$id": "expandRoadmap",
      "name": "Expand Roadmap Topics",
      "runtime": "go-1.23",
      "path": "backend/functions/expandRoadmap",
      "entrypoint": "main.go",
      "schedule": "0 0 * * 0",
      "timeout": 120,
      "enabled": true,
      "logging": true
    },
    {
      "$id": "curateCourses",
      "name": "Curate Courses",
      "runtime": "go-1.23",
      "path": "backend/functions/curateCourses",
      "entrypoint": "main.go",
      "schedule": "0 4 * * 0",
      "timeout": 180,
      "enabled": true,
      "logging": true
    },
    {
      "$id": "onConceptPublish",
      "name": "On Concept Publish",
      "runtime": "go-1.23",
      "path": "backend/functions/onConceptPublish",
      "entrypoint": "main.go",
      "events": [
        "databases.*.collections.concepts.documents.*.create",
        "databases.*.collections.concepts.documents.*.update"
      ],
      "timeout": 60,
      "enabled": true,
      "logging": true
    }
  ],
  "buckets": [
    {
      "$id": "concept-images",
      "name": "Concept Images",
      "$permissions": ["read(\"any\")"],
      "fileSecurity": false,
      "enabled": true,
      "maximumFileSize": 10485760,
      "allowedFileExtensions": ["jpg", "jpeg", "png", "webp", "svg"]
    }
  ]
}
