            "name": "Concept Unified Engine",
            "runtime": "go-1.26",
            "path": "backend/functions/conceptEngine",
            "entrypoint": "main.go",
            "schedule": "0 2 * * *",
            "timeout": 300,
            "enabled": true,
            "logging": true,
            "scopes": [
                "documents.read",
                "documents.write",
                "databases.read",
                "databases.write"
            ]
        }
    ],
